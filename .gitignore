# ==============================================================================
# BiliYTPlayer — .gitignore
# 源码仓库：只提交 Python 源码、构建脚本、mpv 配置参考
# 二进制产物（mpv-portable、EXE、tar.gz）由 GitHub Releases 单独分发
# ==============================================================================

# ── 敏感信息（绝不提交）───────────────────────────────────────────────────────
.env
*.env
.env.*

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── PyInstaller 构建产物 ──────────────────────────────────────────────────────
build/
dist/
*.manifest

# ── 二进制 / 发布产物（走 GitHub Releases）──────────────────────────────────
BiliYTPlayer.exe
BiliYTPlayer_old.exe
BiliYTPlayer_release.tar.gz
*.tar.gz
*.zip
*.zip.orig
mpv-portable/

# ── 日志 / 运行时数据 ─────────────────────────────────────────────────────────
*.log
mpv.log

# ── 工具数据目录 ─────────────────────────────────────────────────────────────
.workbuddy/

# ── 系统 / 编辑器文件 ─────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
*.swp
