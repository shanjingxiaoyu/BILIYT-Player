# ==============================================================================
# BiliYTPlayer — .gitignore
# 源码仓库：只提交 Python 源码、构建脚本、mpv 配置参考
# 二进制产物（mpv-portable、EXE、tar.gz）由 GitHub Releases 单独分发
# ==============================================================================

# ── 敏感信息（绝不提交）───────────────────────────────────────────────────────
.env
*.env
.env.*

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── PyInstaller 构建产物 ──────────────────────────────────────────────────────
build/
dist/
*.manifest

# ── 二进制 / 发布产物（走 GitHub Releases）──────────────────────────────────
BiliYTPlayer.exe
BiliYTPlayer_old.exe
BiliYTPlayer_release.tar.gz
*.tar.gz
*.zip
*.zip.orig
mpv-portable/

# ── 日志 / 运行时数据 ─────────────────────────────────────────────────────────
*.log
mpv.log

# ── 工具数据目录 ─────────────────────────────────────────────────────────────
.workbuddy/

# ── 系统 / 编辑器文件 ─────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
*.swp

# ui-kit 的演示 exe 不进仓库（48 MB），用 Releases 分发
ui-kit/*.exe

# ── 开发期临时探针 / 截图产物（正式自检脚本 _verify_*.py 保留）─────────────────
_scratch/
_probe*
# 根目录下的 png 全是开发期截图产物（仓库内的截图在 ui-kit/ 下，不受影响）
/*.png
/_*.py
!/_verify_*.py
!/_shot*.py
_o.txt
_e.txt

